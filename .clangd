# clangd reads the compile database the build already maintains (regenerated by every
# `GEN=ninja make`); it covers both src/ translation units with the full include set - duckdb,
# the embedded ducklake (ducklake/src/include) and vcpkg's roaring. Without it clangd guesses
# flags and reports every ducklake symbol as undeclared. `GEN=ninja make` (release) is what
# regenerates it; on a box that only ever builds debug, point this at build/debug instead.
CompileFlags:
  CompilationDatabase: build/release
