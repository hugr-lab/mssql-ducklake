# mssql-ducklake integration environment. Copy to .env and adjust if the port or password clash
# with something local. Read by the Makefile (-include .env), which passes the values to
# docker/docker-compose.yml and derives MSSQL_DUCKLAKE_TEST_DSN for `make test-integration`.
#
# The sa password is baked into the data volume on first start - change it here BEFORE the first
# `make docker-up`, or drop the volume (mssql-ducklake-sqlserver-data) afterwards.
MSSQL_DUCKLAKE_HOST=localhost
MSSQL_DUCKLAKE_PORT=7433
MSSQL_DUCKLAKE_USER=sa
MSSQL_DUCKLAKE_PASS=TestPassword1
MSSQL_DUCKLAKE_DB=lake_meta
