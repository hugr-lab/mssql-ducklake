# mssql-ducklake integration environment. Copy to .env and adjust if the port or password clash
# with something local. Read by the Makefile (-include .env), which passes the values to
# docker/docker-compose.yml and derives MSSQL_DUCKLAKE_TEST_DSN for `make test-integration`.
#
# Plain values only: no quotes (make keeps them, and they end up inside the sa password), and no
# `$` or `#` (make expands one and comments out the other).
#
# The sa password is baked into the data volume on first start - change it here BEFORE the first
# `make docker-up`, or drop the volume afterwards (docker compose -f docker/docker-compose.yml down -v).
#
# The database named here is a TEST database: every run of test/sql/integration drops all its
# `ducklake%` tables. The init plants a marker table in it and the tests refuse to reset a database
# without the marker, so a DSN pointed at a real catalog fails instead of wiping it.
MSSQL_DUCKLAKE_HOST=localhost
MSSQL_DUCKLAKE_PORT=7433
MSSQL_DUCKLAKE_PASS=TestPassword1
MSSQL_DUCKLAKE_DB=lake_meta
# the pinned server image (bumped with the other pins, see CLAUDE.md)
# MSSQL_DUCKLAKE_IMAGE=mcr.microsoft.com/mssql/server:2025-CU8-ubuntu-24.04

# The postgres catalog used only by `make bench`, to compare the two DuckLake backends.
MSSQL_DUCKLAKE_PG_PORT=7432
MSSQL_DUCKLAKE_PG_USER=ducklake
MSSQL_DUCKLAKE_PG_PASS=TestPassword1
MSSQL_DUCKLAKE_PG_DB=lake_meta
