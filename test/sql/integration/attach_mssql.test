# name: test/sql/integration/attach_mssql.test
# description: A DuckLake catalog in SQL Server: initialize, DDL, inlined data, re-attach (specs/002, 003)
# group: [integration]

# The server-backed suite: `make docker-up` + `make test-integration` provide the connection string
# (docker/docker-compose.yml, .env.example); without it the file skips. CI's floor forbids the skip.
require-env MSSQL_DUCKLAKE_TEST_DSN

# ducklake binds parquet's copy function for every insert, inlined or not; statically linked, but
# the test runner loads static extensions lazily - `require` brings it up
require parquet

statement ok
LOAD '__BUILD_DIRECTORY__/extension/mssql/mssql.duckdb_extension';

statement ok
LOAD '__BUILD_DIRECTORY__/extension/mssql_ducklake/mssql_ducklake.duckdb_extension';

# a side door into the catalog database, for the reset and for looking at what ducklake wrote
statement ok
ATTACH '${MSSQL_DUCKLAKE_TEST_DSN}' AS srv (TYPE mssql);

# a fresh catalog per run: the lake below must be a NEW DuckLake (its data path is this run's test
# directory, and an existing catalog pins the path it was created with). The reset drops every
# ducklake% table in the DSN's database - only in a database the init script marked as the test
# environment (docker/init/sqlserver.sql), never in one the DSN reached by mistake
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT 1 AS marker FROM sys.tables WHERE name = ''mssql_ducklake_test_env''');
----
1

# The precondition of an incident (specs/008): a shape stamp left on the SCHEMA by the build that
# put it there, outliving the tables it described. With the stamp on the schema, a catalog recreated
# from scratch - here, by this very reset - read as already shaped and was left without keys; the
# stamp now lives on ducklake_metadata and dies with it. The stale schema-level one is planted here
# so the attach below proves it is neither trusted nor left behind.
statement ok
SELECT mssql_exec('srv', 'IF NOT EXISTS (SELECT 1 FROM sys.extended_properties WHERE class = 3 AND major_id = SCHEMA_ID(''dbo'') AND name = ''mssql_ducklake_shape'') EXEC sp_addextendedproperty @name = N''mssql_ducklake_shape'', @value = N''2'', @level0type = N''SCHEMA'', @level0name = N''dbo'';');

statement ok
SELECT mssql_exec('srv', '
DECLARE @sql NVARCHAR(MAX) = N'''';
SELECT @sql += N''DROP TABLE '' + QUOTENAME(s.name) + N''.'' + QUOTENAME(t.name) + N'';''
FROM sys.tables t JOIN sys.schemas s ON s.schema_id = t.schema_id
WHERE s.name = ''dbo'' AND t.name LIKE ''ducklake%'';
EXEC sp_executesql @sql;');

# the same predicate the reset used - a catalog someone put in another schema is not ours to drop,
# and counting it here would wedge every later run
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT t.name FROM sys.tables t JOIN sys.schemas s ON s.schema_id = t.schema_id WHERE s.name = ''dbo'' AND t.name LIKE ''ducklake%''');
----
0

# The database option the shaping applies (specs/012), put back first so that this run proves the
# attach set it rather than an earlier run
statement ok
SELECT mssql_exec('srv', 'ALTER DATABASE CURRENT SET PARAMETERIZATION SIMPLE;');

query I
SELECT f FROM mssql_scan('srv', 'SELECT CAST(is_parameterization_forced AS BIGINT) AS f FROM sys.databases WHERE database_id = DB_ID()');
----
0

# `ducklake:mssql:<ADO connection string>`: duckdb strips the `mssql:` prefix and picks the mssql
# storage for the catalog ATTACH (the `mssql://` URI form is deliberately not a prefix to duckdb -
# it needs META_TYPE 'mssql' instead). No METADATA_SCHEMA: since mssql v0.2.5 the catalog answers
# `dbo` as its default schema (spec 003)
statement ok
ATTACH 'ducklake:mssql:${MSSQL_DUCKLAKE_TEST_DSN}' AS lake (DATA_PATH '__TEST_DIR__/lake');

# a new DuckLake was initialized in SQL Server, in dbo: the whole catalog schema, its metadata,
# snapshot 0
query I
SELECT count(*) > 20 FROM mssql_scan('srv', 'SELECT t.name FROM sys.tables t JOIN sys.schemas s ON s.schema_id = t.schema_id WHERE s.name = ''dbo'' AND t.name LIKE ''ducklake%''');
----
true

query II
SELECT key, value FROM mssql_scan('srv', 'SELECT [key], [value] FROM dbo.ducklake_metadata WHERE [key] IN (''version'', ''encrypted'')') ORDER BY key;
----
encrypted	false
version	1.0

query I
SELECT snapshot_id FROM ducklake_snapshots('lake');
----
0

# and the catalog's database now parameterizes every literal itself: one plan per query shape
# rather than one per table name or id, which is what made the first touch of each table a plan
# compile (specs/009, 012)
query I
SELECT f FROM mssql_scan('srv', 'SELECT CAST(is_parameterization_forced AS BIGINT) AS f FROM sys.databases WHERE database_id = DB_ID()');
----
1

# DDL and an inlined insert through the generic manager: the catalog load behind them reads the
# metadata with decorrelated subqueries, which mssql v0.2.5 materializes on the transaction's
# pinned connection (spec 003); the inlined rows land in a ducklake_inlined_data_* table in dbo
statement ok
CREATE TABLE lake.t(i INTEGER, s VARCHAR);

statement ok
INSERT INTO lake.t VALUES (1, 'a'), (2, 'b');

query II
SELECT * FROM lake.t ORDER BY i;
----
1	a
2	b

# the registration row ducklake reads to find that table (<table_id>_<schema_version>)
query I
SELECT table_name FROM mssql_scan('srv', 'SELECT table_name FROM dbo.ducklake_inlined_data_tables');
----
ducklake_inlined_data_1_1

# Every later write to the same table commits too. What bought that is not a rewritten batch but the
# primary keys this manager puts on the catalog (specs/004 D3): the mssql extension builds a row
# identity out of a key, and without one it refuses the UPDATE of ducklake_table_stats that every
# commit past the first carries. DuckLake's own SQL runs through duckdb, unchanged.
statement ok
INSERT INTO lake.t VALUES (3, 'c');

statement ok
UPDATE lake.t SET s = 'updated' WHERE i = 2;

statement ok
DELETE FROM lake.t WHERE i = 1;

query II
SELECT * FROM lake.t ORDER BY i;
----
2	updated
3	c

# past the inlining limit the rows go to a parquet file, and the catalog records it
statement ok
INSERT INTO lake.t SELECT range, 'row' || range FROM range(10, 40);

query I
SELECT count(*) FROM lake.t;
----
32

query I
SELECT count(*) > 0 FROM mssql_scan('srv', 'SELECT data_file_id FROM dbo.ducklake_data_file');
----
true

statement ok
DETACH lake;

# the second attach finds the existing catalog and loads it (no re-initialization): the table,
# its inlined rows, the snapshots, time travel
statement ok
ATTACH 'ducklake:mssql:${MSSQL_DUCKLAKE_TEST_DSN}' AS lake (DATA_PATH '__TEST_DIR__/lake');

# one snapshot per committed statement: schema, table, and the five writes above
query I
SELECT snapshot_id FROM ducklake_snapshots('lake') ORDER BY 1;
----
0
1
2
3
4
5
6

# and they are physically in dbo, where this attach found them
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT snapshot_id FROM dbo.ducklake_snapshot');
----
7

query I
SELECT count(*) FROM lake.t;
----
32

# time travel still reads the older snapshots of the same table
query II
SELECT * FROM lake.t AT (VERSION => 2) ORDER BY i;
----
1	a
2	b

query I
SELECT count(*) FROM lake.t AT (VERSION => 1);
----
0

# an existing catalog pins its data path
statement error
ATTACH 'ducklake:mssql:${MSSQL_DUCKLAKE_TEST_DSN}' AS lake2 (DATA_PATH '__TEST_DIR__/elsewhere');
----
<REGEX>:.*does not match existing data path.*

statement ok
DETACH lake;

# TODO(specs/004): the type matrix (research note §5 - FLOAT NaN, TIMESTAMP_NS, HUGEINT, STRUCT, a
# non-ASCII string round trip), our own InitializeDuckLake (keys, filtered indexes, the 2019+ gate,
# the UTF-8 collation), and expire/cleanup.

# The inlining type matrix (specs/004 D4). These are the types that decide it: ones SQL Server holds
# natively, ones it cannot hold exactly and so are stored as text and cast back, and a nested one
# DuckLake stores as text itself. The column types are ours and are T-SQL, while the CAST DuckLake
# writes into the commit batch has to stay DuckDB's - a regression either way fails here.
statement ok
ATTACH 'ducklake:mssql:${MSSQL_DUCKLAKE_TEST_DSN}' AS lake (DATA_PATH '__TEST_DIR__/lake');

statement ok
CREATE TABLE lake.types(ts TIMESTAMP, d DATE, u UUID, f DOUBLE, h HUGEINT, s VARCHAR, st STRUCT(a INT));

statement ok
INSERT INTO lake.types VALUES (TIMESTAMP '2026-09-09 12:00:00', DATE '2026-09-09', '01a084b5-b223-7a16-b2c5-7e06e34411fd', 'nan'::DOUBLE, 42, 'привет 😀 ü', {'a': 1});

# a second insert, so the statistics go through their update path as well
statement ok
INSERT INTO lake.types VALUES (NULL, NULL, NULL, 1.5, -7, 'второй', {'a': 2});

query IIIIIII
SELECT ts, d, u, f, h, s, st FROM lake.types ORDER BY s;
----
NULL	NULL	NULL	1.5	-7	второй	{'a': 2}
2026-09-09 12:00:00	2026-09-09	01a084b5-b223-7a16-b2c5-7e06e34411fd	nan	42	привет 😀 ü	{'a': 1}

# what the manager declared on the server: the native types as real columns, the rest as text.
# The join needs COLLATE DATABASE_DEFAULT: the catalog's own string columns carry the UTF-8 BIN2
# collation (specs/006 D4) while sys.tables.name carries the database's, and SQL Server refuses to
# compare two explicit collations without being told which one wins.
query II
SELECT name, typ FROM mssql_scan('srv', 'SELECT c.name, ty.name AS typ FROM dbo.ducklake_inlined_data_tables idt JOIN dbo.ducklake_table lt ON lt.table_id = idt.table_id AND lt.table_name = ''types'' JOIN sys.tables t ON t.name = idt.table_name COLLATE DATABASE_DEFAULT JOIN sys.columns c ON c.object_id = t.object_id JOIN sys.types ty ON ty.user_type_id = c.user_type_id WHERE c.column_id > 3') ORDER BY name;
----
d	date
f	varchar
h	varchar
s	varchar
st	varchar
ts	datetime2
u	uniqueidentifier

# and every text column of it carries the binary UTF-8 collation the comparisons need
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT c.name FROM sys.columns c JOIN sys.tables t ON t.object_id = c.object_id WHERE t.name LIKE ''ducklake_inlined_data[_][0-9]%'' AND c.collation_name IS NOT NULL AND c.collation_name <> ''Latin1_General_100_BIN2_UTF8''');
----
0

# Non-ASCII through the catalog's VARCHAR columns (specs/006 D4). The conversion off NVARCHAR only
# holds because the collation is a UTF-8 one - under a single-byte collation VARCHAR would mangle
# exactly this. Identifiers and values both, since both are stored in those columns.
statement ok
CREATE TABLE lake."таблица_табло"("колонка" VARCHAR, emoji VARCHAR);

statement ok
INSERT INTO lake."таблица_табло" VALUES ('значение — ünïcode', '🦆🏔️');

query TT
SELECT "колонка", emoji FROM lake."таблица_табло";
----
значение — ünïcode	🦆🏔️

# past the inlining limit too, so the name travels through ducklake_table and the file path rather
# than through an inlined table
statement ok
INSERT INTO lake."таблица_табло" SELECT 'строка' || r::VARCHAR, '漢字テスト' FROM range(200) t(r);

query II
SELECT count(*), count(DISTINCT "колонка") FROM lake."таблица_табло";
----
201	201

# the name reached ducklake_table intact. The literal is N-prefixed because a bare T-SQL literal is
# read in the database's own collation codepage, which here cannot hold Cyrillic - the column's UTF-8
# collation governs the comparison, not the literal's spelling.
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT table_name FROM dbo.ducklake_table WHERE table_name = N''таблица_табло''');
----
1

# A non-ASCII PARTITION key, which is where the VARCHAR(200) bound and the collation meet: the value
# is an index key now, and under UTF-8 a Cyrillic character costs two of those 200 bytes.
statement ok
CREATE TABLE lake.parted_by_text(id BIGINT, ключ VARCHAR, v BIGINT);

statement ok
ALTER TABLE lake.parted_by_text SET PARTITIONED BY (ключ);

statement ok
INSERT INTO lake.parted_by_text SELECT r, 'раздел' || (r % 5)::VARCHAR, r FROM range(100) t(r);

# the pruned read, which is what the partition index serves
query II
SELECT count(*), sum(v) FROM lake.parted_by_text WHERE ключ = 'раздел3';
----
20	1010

# and the values are in the catalog as written, not mangled into the database's codepage
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT DISTINCT partition_value FROM dbo.ducklake_file_partition_value WHERE partition_value LIKE N''раздел%''');
----
5

# The appender path (specs/006 D1). A commit's data files now go through DuckLake's appender rather
# than into the one SQL batch, which is what SupportsAppender() answers. What these assertions check
# is that the rows are the same either way - they would pass on the SQL batch too, and deliberately
# so: the appender is worth taking only because it changes nothing about the result. Which path ran
# is measured, not asserted (round trips per commit, specs/006 D1); a test that read the plan cache
# to tell them apart would be reading state every other test on the server writes to.
#
# The commit below is fifty data files, comfortably past the size where the two paths diverge.
statement ok
CREATE TABLE lake.parts(part BIGINT, v BIGINT);

statement ok
ALTER TABLE lake.parts SET PARTITIONED BY (part);

# one commit, fifty data files
statement ok
INSERT INTO lake.parts SELECT r % 50, r FROM range(1000) t(r);

query III
SELECT count(*), sum(v), count(DISTINCT part) FROM lake.parts;
----
1000	499500	50

# fifty rows in the catalog to match, written by the appender inside the commit's own transaction
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT f.data_file_id FROM dbo.ducklake_data_file f JOIN dbo.ducklake_table t ON t.table_id = f.table_id WHERE t.table_name = ''parts'' AND f.end_snapshot IS NULL');
----
50

# a table created and filled in ONE transaction: the appender writes ducklake_data_file rows for a
# table the catalog does not know yet, resolving its path from the commit's own new-table list
statement ok
BEGIN TRANSACTION;

statement ok
CREATE TABLE lake.made_and_filled(part BIGINT, v BIGINT);

statement ok
INSERT INTO lake.made_and_filled SELECT r % 10, r FROM range(200) t(r);

statement ok
COMMIT;

query III
SELECT count(*), sum(v), count(DISTINCT part) FROM lake.made_and_filled;
----
200	19900	10

# and a rollback takes the appended rows with it - it writes through the metadata connection, so it
# is in the same transaction as everything else the commit does
statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO lake.parts SELECT r % 50, r FROM range(1000, 2000) t(r);

statement ok
ROLLBACK;

query II
SELECT count(*), sum(v) FROM lake.parts;
----
1000	499500

# no orphaned file rows in any snapshot state, only the fifty that committed
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT f.data_file_id FROM dbo.ducklake_data_file f JOIN dbo.ducklake_table t ON t.table_id = f.table_id WHERE t.table_name = ''parts''');
----
50

# MERGE INTO on lake tables (specs/006 D3). DuckLake plans it itself; what it produces here is a
# commit carrying a delete file beside a data file - a shape the phase-2 server-side apply declines
# and the client commit loop has to take. All three match clauses, on a file-backed table.
statement ok
CREATE TABLE lake.merged AS SELECT r AS id, r AS v FROM range(1000) t(r);

statement ok
CREATE TABLE upserts AS SELECT r AS id, r * 10 AS v FROM range(500, 1500) t(r);

statement ok
MERGE INTO lake.merged AS t USING upserts AS s ON t.id = s.id
  WHEN MATCHED THEN UPDATE SET v = s.v
  WHEN NOT MATCHED THEN INSERT (id, v) VALUES (s.id, s.v);

query II
SELECT count(*), sum(v) FROM lake.merged;
----
1500	10119750

statement ok
MERGE INTO lake.merged AS t USING (SELECT r AS id FROM range(0, 100) t(r)) AS s ON t.id = s.id
  WHEN MATCHED THEN DELETE;

query II
SELECT count(*), sum(v) FROM lake.merged;
----
1400	10114800

statement ok
MERGE INTO lake.merged AS t USING (SELECT r AS id FROM range(1000, 1500) t(r)) AS s ON t.id = s.id
  WHEN NOT MATCHED BY SOURCE THEN DELETE;

query II
SELECT count(*), sum(v) FROM lake.merged;
----
500	6247500

# and on an inlined table, where the rows live in the catalog itself rather than in a parquet file
statement ok
CREATE TABLE lake.merged_small AS SELECT r AS id, r AS v FROM range(4) t(r);

statement ok
MERGE INTO lake.merged_small AS t USING (SELECT 2 AS id, 99 AS v) AS s ON t.id = s.id
  WHEN MATCHED THEN UPDATE SET v = s.v
  WHEN NOT MATCHED THEN INSERT (id, v) VALUES (s.id, s.v);

query II
SELECT count(*), sum(v) FROM lake.merged_small;
----
4	103

# The read layer in T-SQL (specs/008). One lookup a read makes - does this table have an inlined
# deletion table - goes through mssql_scan now: the base asked it as a catalog query whose error
# state meant "absent", and a miss made the mssql extension reload the whole schema's metadata. The
# other four scalar lookups stay on the catalog path on purpose (measured: their scans warm exactly
# the tables the commit then writes). Which path ran is ASSERTED here, through DuckLake's own
# metadata log: specs/006's appender test could not tell its paths apart, this one can.
statement ok
SET logging_storage = 'memory';

statement ok
SET enable_logging = true;

statement ok
SET logging_level = 'debug';

statement ok
SET enabled_log_types = 'DuckLakeMetadata';

query II
SELECT count(*), sum(v) FROM lake.merged;
----
500	6247500

query II
SELECT count(*), sum(v) FROM lake.merged_small;
----
4	103

query I
SELECT count(*) FROM lake.parts;
----
1000

# the base's probe must not appear at all, and the replacement must
query I
SELECT count(*) FROM duckdb_logs() WHERE type = 'DuckLakeMetadata' AND message LIKE '%ducklake_inlined_delete_% LIMIT 1%';
----
0

query I
SELECT count(*) > 0 FROM duckdb_logs() WHERE type = 'DuckLakeMetadata' AND message LIKE '%mssql_scan(%OBJECT_ID(%';
----
true

# and the four counters are still catalog scans - the warm path, kept on purpose
query I
SELECT count(*) > 0 FROM duckdb_logs() WHERE type = 'DuckLakeMetadata' AND message LIKE '%SUM(record_count) FROM "__ducklake_metadata_lake"%';
----
true

statement ok
SET enable_logging = false;

statement ok
DETACH lake;

# The catalog carries the keys and indexes the manager put on it (specs/004 D3). Every count here is
# scoped to dbo: sys.indexes and sys.key_constraints are per database, and a second lake in another
# schema of the same database - which this file creates below - would otherwise be counted too.
query I
SELECT count(*) > 20 FROM mssql_scan('srv', 'SELECT name FROM sys.key_constraints WHERE type = ''PK'' AND schema_id = SCHEMA_ID(''dbo'')');
----
true

# three filtered indexes, on tables whose hot read is the catalog load and so only ever asks for the
# current state
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT i.name FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE i.has_filter = 1 AND o.schema_id = SCHEMA_ID(''dbo'')');
----
3

# and the two file tables keyed on the whole visibility condition instead, so a read at an older
# snapshot seeks rather than scanning the table - a filtered index cannot serve one at all
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT i.name FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE i.name LIKE ''ix_ducklake_%_visible'' AND o.schema_id = SCHEMA_ID(''dbo'')');
----
2

# the per-column statistics a filtered read prunes with, on the predicate that read carries
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT i.name FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE i.name = ''ix_ducklake_file_column_stats_lookup'' AND o.schema_id = SCHEMA_ID(''dbo'')');
----
1

# and the partition values a pruned read seeks, on the predicate DuckLake builds for one
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT i.name FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE i.name = ''ix_ducklake_file_partition_value_lookup'' AND o.schema_id = SCHEMA_ID(''dbo'')');
----
1

# No NVARCHAR anywhere in the catalog (specs/006 D4). mssql maps DuckDB's VARCHAR to NVARCHAR - UTF-16,
# two bytes per character for content that is paths and identifiers, under a linguistic
# case-insensitive collation. DuckDB has neither, so the manager converts every string column to
# VARCHAR under the UTF-8 BIN2 collation, generated from sys.columns so a column added by a ducklake
# bump is converted too.
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT c.name FROM sys.columns c JOIN sys.tables t ON t.object_id = c.object_id JOIN sys.schemas s ON s.schema_id = t.schema_id JOIN sys.types ty ON ty.user_type_id = c.user_type_id WHERE s.name = ''dbo'' AND t.name LIKE ''ducklake%'' AND ty.name IN (''nvarchar'', ''nchar'', ''ntext'')');
----
0

# and every string column in the catalog carries that one collation, not just the statistics ones
query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT c.name FROM sys.columns c JOIN sys.tables t ON t.object_id = c.object_id JOIN sys.schemas s ON s.schema_id = t.schema_id WHERE s.name = ''dbo'' AND t.name LIKE ''ducklake%'' AND c.collation_name IS NOT NULL AND c.collation_name <> ''Latin1_General_100_BIN2_UTF8''');
----
0

# the partition value is bounded so it can be an index key at all - unbounded it is a LOB, and a LOB
# can be neither a key nor an INCLUDE (max_length is in bytes for VARCHAR, so 200 is VARCHAR(200))
query II
SELECT t, l FROM mssql_scan('srv', 'SELECT ty.name AS t, CAST(c.max_length AS BIGINT) AS l FROM sys.columns c JOIN sys.tables tb ON tb.object_id = c.object_id JOIN sys.types ty ON ty.user_type_id = c.user_type_id WHERE tb.name = ''ducklake_file_partition_value'' AND tb.schema_id = SCHEMA_ID(''dbo'') AND c.name = ''partition_value''');
----
varchar	200

# the shape version this build wrote - on the catalog's anchor table, which is what
# CatalogShapeIsCurrent reads on the next attach - and the stale schema-level one planted at the top
# of this file is gone
query I
SELECT v FROM mssql_scan('srv', 'SELECT CAST(value AS VARCHAR(32)) AS v FROM sys.extended_properties WHERE class = 1 AND major_id = OBJECT_ID(''dbo.ducklake_metadata'') AND minor_id = 0 AND name = ''mssql_ducklake_shape''');
----
4

query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT name FROM sys.extended_properties WHERE class = 3 AND major_id = SCHEMA_ID(''dbo'') AND name = ''mssql_ducklake_shape''');
----
0

# A catalog shaped by an OLDER build is brought up to the current shape on attach. It was not: the
# marker used to be the presence of one constraint, which answers "some build shaped this" - so a
# catalog with the wrong column types and missing indexes read as current and was left alone. Here
# the stamp is removed and a column put back the way DuckLake declares it, as an older build left it.
statement ok
SELECT mssql_exec('srv', 'EXEC sp_dropextendedproperty @name = N''mssql_ducklake_shape'', @level0type = N''SCHEMA'', @level0name = N''dbo'', @level1type = N''TABLE'', @level1name = N''ducklake_metadata'';
DROP INDEX ix_ducklake_file_partition_value_lookup ON dbo.ducklake_file_partition_value;
ALTER TABLE dbo.ducklake_file_partition_value ALTER COLUMN partition_value NVARCHAR(MAX) NULL;');

query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT c.name FROM sys.columns c JOIN sys.tables t ON t.object_id = c.object_id JOIN sys.types ty ON ty.user_type_id = c.user_type_id WHERE t.name = ''ducklake_file_partition_value'' AND c.name = ''partition_value'' AND ty.name = ''nvarchar''');
----
1

# The database option is the one thing the shaping does outside the catalog's own schema, so it has
# an opt-out. Put the database back to SIMPLE and opt out: this re-shaping must leave it alone
statement ok
SELECT mssql_exec('srv', 'ALTER DATABASE CURRENT SET PARAMETERIZATION SIMPLE;');

statement ok
SET mssql_ducklake_forced_parameterization = false;

statement ok
ATTACH 'ducklake:mssql:${MSSQL_DUCKLAKE_TEST_DSN}' AS upgraded (DATA_PATH '__TEST_DIR__/lake');

query I
SELECT f FROM mssql_scan('srv', 'SELECT CAST(is_parameterization_forced AS BIGINT) AS f FROM sys.databases WHERE database_id = DB_ID()');
----
0

# the attach noticed and re-applied: the column is back to VARCHAR(200) and the index is back
query II
SELECT t, l FROM mssql_scan('srv', 'SELECT ty.name AS t, CAST(c.max_length AS BIGINT) AS l FROM sys.columns c JOIN sys.tables tb ON tb.object_id = c.object_id JOIN sys.types ty ON ty.user_type_id = c.user_type_id WHERE tb.name = ''ducklake_file_partition_value'' AND tb.schema_id = SCHEMA_ID(''dbo'') AND c.name = ''partition_value''');
----
varchar	200

query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT i.name FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE i.name = ''ix_ducklake_file_partition_value_lookup'' AND o.schema_id = SCHEMA_ID(''dbo'')');
