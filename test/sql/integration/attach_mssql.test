1

statement ok
DETACH upgraded;

# opted back in, the next shaping applies it - the stamp is removed again so there is one
statement ok
RESET mssql_ducklake_forced_parameterization;

statement ok
SELECT mssql_exec('srv', 'EXEC sp_dropextendedproperty @name = N''mssql_ducklake_shape'', @level0type = N''SCHEMA'', @level0name = N''dbo'', @level1type = N''TABLE'', @level1name = N''ducklake_metadata'';');

statement ok
ATTACH 'ducklake:mssql:${MSSQL_DUCKLAKE_TEST_DSN}' AS reshaped (DATA_PATH '__TEST_DIR__/lake');

query I
SELECT f FROM mssql_scan('srv', 'SELECT CAST(is_parameterization_forced AS BIGINT) AS f FROM sys.databases WHERE database_id = DB_ID()');
----
1

# A flush after an inlined deletion of file-backed rows. The deletions live in
# ducklake_inlined_delete_<table>, which the base created keyless inside the transaction, and the
# flush DELETEs from it - refused by the mssql extension without a key ("UPDATE/DELETE requires a
# table with a primary key"). The manager creates it keyed now, the way it creates the inlined data
# table (specs/006 D5), and the key is visible on the server.
statement ok
CREATE TABLE reshaped.fd AS SELECT i, 'r' || i AS s FROM range(20) r(i);

statement ok
DELETE FROM reshaped.fd WHERE i IN (3, 7);

query I
SELECT count(*) > 0 FROM mssql_scan('srv', 'SELECT kc.name FROM sys.key_constraints kc JOIN sys.tables t ON t.object_id = kc.parent_object_id WHERE t.name LIKE ''ducklake_inlined_delete%'' AND t.schema_id = SCHEMA_ID(''dbo'') AND kc.type = ''PK''');
----
true

statement ok
SELECT count(*) FROM ducklake_flush_inlined_data('reshaped');

query I
SELECT count(*) FROM reshaped.fd;
----
18

# An older build created that table keyless, through the base's DDL. Its key is dropped here to
# stand in for that, with the shape stamp, and the next attach keys it again
statement ok
DETACH reshaped;

statement ok
SELECT mssql_exec('srv', 'EXEC sp_dropextendedproperty @name = N''mssql_ducklake_shape'', @level0type = N''SCHEMA'', @level0name = N''dbo'', @level1type = N''TABLE'', @level1name = N''ducklake_metadata'';
DECLARE @drop NVARCHAR(MAX) = N''''; SELECT @drop += N''ALTER TABLE dbo.'' + QUOTENAME(t.name) + N'' DROP CONSTRAINT '' + QUOTENAME(kc.name) + N'';'' FROM sys.key_constraints kc JOIN sys.tables t ON t.object_id = kc.parent_object_id WHERE t.name LIKE ''ducklake_inlined_delete%'' AND t.schema_id = SCHEMA_ID(''dbo''); EXEC sp_executesql @drop;');

query I
SELECT count(*) FROM mssql_scan('srv', 'SELECT kc.name FROM sys.key_constraints kc JOIN sys.tables t ON t.object_id = kc.parent_object_id WHERE t.name LIKE ''ducklake_inlined_delete%'' AND t.schema_id = SCHEMA_ID(''dbo'')');
----
0

statement ok
ATTACH 'ducklake:mssql:${MSSQL_DUCKLAKE_TEST_DSN}' AS rekeyed (DATA_PATH '__TEST_DIR__/lake');

query I
SELECT count(*) > 0 FROM mssql_scan('srv', 'SELECT kc.name FROM sys.key_constraints kc JOIN sys.tables t ON t.object_id = kc.parent_object_id WHERE t.name LIKE ''ducklake_inlined_delete%'' AND t.schema_id = SCHEMA_ID(''dbo'')');
----
true

# and DuckLake can still delete from it: a second flush after another inlined deletion
statement ok
DELETE FROM rekeyed.fd WHERE i = 11;

statement ok
SELECT count(*) FROM ducklake_flush_inlined_data('rekeyed');

query I
SELECT count(*) FROM rekeyed.fd;
----
17

statement ok
DROP TABLE rekeyed.fd;

statement ok
DETACH rekeyed;

# A second lake in another schema of the same database gets its own indexes. It did not: index names
# embed the table but not the schema, and `sys.indexes.name` is unique per table rather than per
# database, so an existence check that did not scope by schema saw the first lake's index and skipped
# creating the second lake's. The catalog then worked but read without indexes, which nothing would
# have noticed.
# tables first: a run that died after creating this lake leaves the schema populated, and DROP SCHEMA
# refuses a schema that still owns objects - which would wedge every later run on this server
statement ok
SELECT mssql_exec('srv', '
DECLARE @sql NVARCHAR(MAX) = N'''';
SELECT @sql += N''DROP TABLE '' + QUOTENAME(s.name) + N''.'' + QUOTENAME(t.name) + N'';''
FROM sys.tables t JOIN sys.schemas s ON s.schema_id = t.schema_id
WHERE s.name = ''lake_second'';
EXEC sp_executesql @sql;');

statement ok
SELECT mssql_exec('srv', 'DROP SCHEMA IF EXISTS lake_second;');

statement ok
SELECT mssql_exec('srv', 'CREATE SCHEMA lake_second;');

statement ok
ATTACH 'ducklake:mssql:${MSSQL_DUCKLAKE_TEST_DSN}' AS second (DATA_PATH '__TEST_DIR__/second', METADATA_SCHEMA 'lake_second');

statement ok
CREATE TABLE second.t(i BIGINT);

statement ok
INSERT INTO second.t VALUES (1);

query I
SELECT count(*) FROM second.t;
----
1

# both schemas, the same seven indexes each
query II
SELECT s, n FROM mssql_scan('srv', 'SELECT s.name AS s, COUNT(*) AS n FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id JOIN sys.schemas s ON s.schema_id = o.schema_id WHERE i.name LIKE ''ix_ducklake%'' GROUP BY s.name ORDER BY s.name') ORDER BY s;
----
dbo	7
lake_second	7

statement ok
DETACH second;

statement ok
SELECT mssql_exec('srv', 'DECLARE @s NVARCHAR(MAX)=N''''; SELECT @s += N''DROP TABLE ''+QUOTENAME(s.name)+N''.''+QUOTENAME(t.name)+N'';'' FROM sys.tables t JOIN sys.schemas s ON s.schema_id=t.schema_id WHERE s.name = ''lake_second''; EXEC sp_executesql @s;');

statement ok
SELECT mssql_exec('srv', 'DROP SCHEMA lake_second;');

statement ok
DETACH srv;
