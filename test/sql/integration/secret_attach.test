# name: test/sql/integration/secret_attach.test
# description: the metadata ATTACH's defaults reach a catalog attached through a ducklake secret too
# group: [integration]

require-env MSSQL_DUCKLAKE_TEST_DSN

require parquet

statement ok
SET autoload_known_extensions = false;

statement ok
LOAD '__BUILD_DIRECTORY__/extension/mssql/mssql.duckdb_extension';

statement ok
LOAD '__BUILD_DIRECTORY__/extension/mssql_ducklake/mssql_ducklake.duckdb_extension';

statement ok
ATTACH '${MSSQL_DUCKLAKE_TEST_DSN}' AS srv (TYPE mssql);

statement ok
SELECT mssql_exec('srv', '
DECLARE @sql NVARCHAR(MAX) = N'''';
SELECT @sql += N''DROP TABLE '' + QUOTENAME(s.name) + N''.'' + QUOTENAME(t.name) + N'';''
FROM sys.tables t JOIN sys.schemas s ON s.schema_id = t.schema_id WHERE s.name = ''secret_attach'';
EXEC sp_executesql @sql;
IF SCHEMA_ID(''secret_attach'') IS NULL EXEC(''CREATE SCHEMA secret_attach'');');

# everything in the secret - the path, the schema - and nothing but the name at the ATTACH, the way a
# remote secret storage hands a lake out
statement ok
CREATE SECRET lake_secret (TYPE ducklake, METADATA_PATH 'mssql:${MSSQL_DUCKLAKE_TEST_DSN}', DATA_PATH '__TEST_DIR__/secret_attach', METADATA_SCHEMA 'secret_attach');

statement ok
ATTACH 'ducklake:lake_secret' AS lake;

statement ok
CREATE TABLE lake.t(i INTEGER, v VARCHAR);

statement ok
INSERT INTO lake.t VALUES (1, 'a'), (2, 'b');

query II
SELECT count(*), max(v) FROM lake.t;
----
2	b

# native_types false reached it: the bounded catalog strings are plain VARCHAR
query I
SELECT column_type FROM (DESCRIBE __ducklake_metadata_lake.secret_attach.ducklake_table) WHERE column_name = 'table_name';
----
VARCHAR

# min_connections 4 reached it: the pool was opened warm
query I
SELECT total_connections >= 4 FROM mssql_pool_stats() WHERE db = '__ducklake_metadata_lake';
----
true

statement ok
DETACH lake;

# an option at the ATTACH still wins over the injected default
statement ok
ATTACH 'ducklake:lake_secret' AS lake (META_NATIVE_TYPES true);

query I
SELECT column_type FROM (DESCRIBE __ducklake_metadata_lake.secret_attach.ducklake_table) WHERE column_name = 'table_name';
----
MSSQL_VARCHAR(256)

statement ok
DETACH lake;

statement ok
DROP SECRET lake_secret;

statement ok
SELECT mssql_exec('srv', '
DECLARE @sql NVARCHAR(MAX) = N'''';
SELECT @sql += N''DROP TABLE '' + QUOTENAME(s.name) + N''.'' + QUOTENAME(t.name) + N'';''
FROM sys.tables t JOIN sys.schemas s ON s.schema_id = t.schema_id WHERE s.name = ''secret_attach'';
EXEC sp_executesql @sql; DROP SCHEMA secret_attach;');
